# FAULTLINE Application Settings
FAULTLINE_APP_NAME=faultline
FAULTLINE_ENV=development
FAULTLINE_DEBUG=false
FAULTLINE_LOG_LEVEL=INFO
FAULTLINE_API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL Async)
FAULTLINE_DATABASE_URL=postgresql+asyncpg://faultline:faultline_dev_password@localhost:5432/faultline
FAULTLINE_DB_ECHO=false